<!-- ===== 路标打卡弹窗 ===== -->
<div class="checkin-modal" id="checkinModal">
  <div class="checkin-sheet" id="checkinSheet">
    <div class="sheet-handle"></div>
    <div class="checkin-header">
      <div class="checkin-icon" id="ciIcon">🎯</div>
      <div>
        <div class="checkin-title" id="ciTitle">打卡：第一次实习</div>
        <div class="checkin-subtitle" id="ciSubtitle">记录你的经历，点亮路标！</div>
      </div>
    </div>
    <div id="ciBody">
      <!-- 动态内容 -->
    </div>
    <div style="display:flex;gap:10px;margin-top:14px;">
      <button class="btn-secondary" style="flex:1;" onclick="closeCheckin()">取消</button>
      <button class="btn-primary" style="flex:1;margin:0;" onclick="confirmCheckin()">✅ 确认打卡，领取🪙</button>
    </div>
  </div>
</div>

<!-- 吐司 -->
<div class="toast" id="toastMsg"></div>

<script>
// ============================================================
//  ===== 全局状态 =====
// ============================================================
// ============================================================
//  ===== 后端 API 通信层 =====
// ============================================================
const API_BASE = window.location.origin;  // 同源，直接走 Flask

// 封装 API 请求（自动附带 JWT Token）
// 不需要 Token 的接口列表（登录、注册、发送验证码等）
const NO_AUTH_URLS = ['/api/login', '/api/register', '/api/send-email-code', '/api/login-by-email', '/api/health'];
async function api(url, options = {}) {
  const token = localStorage.getItem('career_token');
  // 安全地合并 headers，避免展开 undefined 报错
  const headers = Object.assign(
    { 'Content-Type': 'application/json' },
    (options && options.headers) || {},
    token ? { 'Authorization': 'Bearer ' + token } : {}
  );
  // 构建 fetch 参数：合并 options 的其他属性（method、body 等），用合并好的 headers 覆盖
  const fetchOptions = Object.assign({}, options);
  fetchOptions.headers = headers;
  try {
    const resp = await fetch(API_BASE + url, fetchOptions);
    const data = await resp.json();
    // Token 过期处理：仅对需要认证的接口做跳转
    if (resp.status === 401 && !NO_AUTH_URLS.includes(url)) {
      localStorage.removeItem('career_token');
      localStorage.removeItem('career_user');
      showAuthOverlay();
      return data;
    }
    return data;
  } catch (e) {
    console.error('API request failed:', url, e);
    return { ok: false, msg: '网络请求失败，请检查后端服务是否启动' };
  }
}

// ============================================================
//  ===== 登录/注册逻辑 =====
// ============================================================
let currentUser = null;

function switchAuthTab(tab) {
  document.querySelectorAll('.auth-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.auth-form').forEach(f => f.classList.remove('active'));
  hideAuthMsg();
  if (tab === 'login') {
    document.getElementById('tabLogin').classList.add('active');
    document.getElementById('formLogin').classList.add('active');
  } else if (tab === 'register') {
    document.getElementById('tabRegister').classList.add('active');
    document.getElementById('formRegister').classList.add('active');
  } else {
    document.getElementById('tabEmail').classList.add('active');
    document.getElementById('formEmail').classList.add('active');
  }
}

function showAuthMsg(text, type) {
  const el = document.getElementById('authMsg');
  el.textContent = text;
  el.className = 'auth-msg ' + type;
}

function hideAuthMsg() {
  document.getElementById('authMsg').className = 'auth-msg';
  document.getElementById('authMsg').textContent = '';
}

function showAuthOverlay() {
  document.getElementById('authOverlay').classList.remove('hidden');
  document.getElementById('userMenu').style.display = 'none';
}

function hideAuthOverlay() {
  document.getElementById('authOverlay').classList.add('hidden');
}

async function handleLogin() {
  const username = document.getElementById('loginUsername').value.trim();
  const password = document.getElementById('loginPassword').value;
  if (!username || !password) { showAuthMsg('请输入用户名和密码', 'error'); return; }

  const btn = document.querySelector('#formLogin .auth-btn-primary');
  btn.disabled = true; btn.textContent = '登录中...';

  const res = await api('/api/login', {
    method: 'POST',
    body: JSON.stringify({ username, password })
  });

  btn.disabled = false; btn.textContent = '🚀 登录';

  if (res.ok) {
    onLoginSuccess(res.token, res.user);
  } else {
    showAuthMsg(res.msg || '登录失败', 'error');
  }
}

async function handleRegister() {
  const username = document.getElementById('regUsername').value.trim();
  const password = document.getElementById('regPassword').value;
  const password2 = document.getElementById('regPassword2').value;
  const email = document.getElementById('regEmail').value.trim();

  if (!username || !password) { showAuthMsg('用户名和密码不能为空', 'error'); return; }
  if (password !== password2) { showAuthMsg('两次输入的密码不一致', 'error'); return; }
  if (password.length < 6) { showAuthMsg('密码长度至少6位', 'error'); return; }

  const btn = document.querySelector('#formRegister .auth-btn-primary');
  btn.disabled = true; btn.textContent = '注册中...';

  const res = await api('/api/register', {
    method: 'POST',
    body: JSON.stringify({ username, password, email: email || undefined })
  });

  btn.disabled = false; btn.textContent = '📝 注册';

  if (res.ok) {
    showAuthMsg('注册成功！正在登录...', 'success');
    setTimeout(() => onLoginSuccess(res.token, res.user), 500);
  } else {
    showAuthMsg(res.msg || '注册失败', 'error');
  }
}

let codeCountdown = 0;
async function handleSendCode() {
  const email = document.getElementById('emailAddr').value.trim();
  if (!email) { showAuthMsg('请输入邮箱地址', 'error'); return; }

  if (codeCountdown > 0) return;

  const res = await api('/api/send-email-code', {
    method: 'POST',
    body: JSON.stringify({ email, purpose: 'login' })
  });

  if (res.ok) {
    showAuthMsg(res.msg || '验证码已发送', 'success');
    // 如果开发模式，自动填入验证码
    if (res.dev_code) {
      document.getElementById('emailCode').value = res.dev_code;
    }
    // 倒计时
    codeCountdown = 60;
    const btn = document.getElementById('sendCodeBtn');
    const timer = setInterval(() => {
      codeCountdown--;
      btn.textContent = codeCountdown + 's';
      btn.disabled = true;
      if (codeCountdown <= 0) { clearInterval(timer); btn.textContent = '发送验证码'; btn.disabled = false; }
    }, 1000);
  } else {
    showAuthMsg(res.msg || '发送失败', 'error');
  }
}

async function handleEmailLogin() {
  const email = document.getElementById('emailAddr').value.trim();
  const code = document.getElementById('emailCode').value.trim();
  if (!email || !code) { showAuthMsg('请输入邮箱和验证码', 'error'); return; }

  const btn = document.querySelector('#formEmail .auth-btn-primary');
  btn.disabled = true; btn.textContent = '验证中...';

  const res = await api('/api/login-by-email', {
    method: 'POST',
    body: JSON.stringify({ email, code })
  });

  btn.disabled = false; btn.textContent = '📧 登录 / 注册';

  if (res.ok) {
    onLoginSuccess(res.token, res.user);
  } else {
    showAuthMsg(res.msg || '验证失败', 'error');
  }
}

function onLoginSuccess(token, user) {
  localStorage.setItem('career_token', token);
  localStorage.setItem('career_user', JSON.stringify(user));
  currentUser = user;
  hideAuthOverlay();
  // 更新 UI
  document.getElementById('userMenu').style.display = 'block';
  document.getElementById('userAvatarBtn').textContent = user.avatar || '🧑';
  document.getElementById('dropdownUserInfo').textContent = `👤 ${user.username}` + (user.email ? ` · ${user.email}` : '');
  // 加载用户数据
  loadUserPlan();
  // 检查 AI 状态
  checkAIStatus();
  showToast(`👋 欢迎回来，${user.username}！`);
}

function handleLogout() {
  localStorage.removeItem('career_token');
  localStorage.removeItem('career_user');
  currentUser = null;
  document.getElementById('userMenu').style.display = 'none';
  closeUserDropdown();
  showAuthOverlay();
  showToast('👋 已退出登录');
}

function toggleUserDropdown() {
  document.getElementById('userDropdown').classList.toggle('show');
}

function closeUserDropdown() {
  document.getElementById('userDropdown').classList.remove('show');
}

// 点击页面其他区域关闭下拉菜单
document.addEventListener('click', function(e) {
  const menu = document.getElementById('userMenu');
  if (menu && !menu.contains(e.target)) closeUserDropdown();
});

// ============================================================
//  ===== 用户数据加载/保存 =====
// ============================================================

async function loadUserPlan() {
  const res = await api('/api/plan');
  if (res.ok && res.plan) {
    const plan = res.plan;
    // 恢复表单数据
    if (plan.form_data) {
      state.form = plan.form_data;
      restoreFormData();
    }
    // 恢复标签选择
    if (plan.selected_tags) {
      state.sel = plan.selected_tags;
      restoreTagSelections();
    }
    // 恢复 MBTI
    if (plan.mbti_result) {
      state.mbti = plan.mbti_result;
    }
    // 如果有 AI 规划结果，恢复里程碑 + 打卡记录
    if (plan.ai_plan) {
      try {
        const aiResult = JSON.parse(plan.ai_plan);
        if (aiResult.milestones) {
          state.milestones = aiResult.milestones.map(m => ({
            id: m.id||('n'+Math.random().toString(36).substr(2,4)),
            icon: m.icon||'📍', color: m.color||'#6366f1',
            label: m.label||'里程碑', time: m.time||'待定',
            desc: m.desc||'', checkinType: m.checkinType||'text',
            checkinLabel: m.checkinLabel||'记录你的经历', done: !!m.done
          }));
          // 恢复打卡记录
          if (aiResult.checkedNodes) {
            state.checkedNodes = aiResult.checkedNodes;
          }
          renderHRoadmap();
          // 自动跳转到路线图页面
          goToStep(4);
          showToast('📂 已恢复你的职业规划路线图！');
          return;
        }
      } catch(e) { console.warn('恢复AI规划失败:', e); }
    }
    showToast('📂 已加载你的规划数据');
  }
}

async function savePlanToServer(aiPlanJson) {
  saveFormData();
  // 如果传入了 aiPlanJson（初次生成），解析后附加 checkedNodes 再存；
  // 若未传入但已有里程碑，则把当前 milestones + checkedNodes 打包存储
  let planToSave = null;
  if (aiPlanJson) {
    try {
      const obj = JSON.parse(aiPlanJson);
      obj.checkedNodes = state.checkedNodes;
      planToSave = JSON.stringify(obj);
    } catch(e) { planToSave = aiPlanJson; }
  } else if (state.milestones.length > 0) {
    // 只更新 checkedNodes（里程碑本身已在 milestones 中）
    // 从 /api/plan 获取最新存储，保留 milestones，只更新 checkedNodes
    try {
      const existing = await api('/api/plan');
      if (existing.ok && existing.plan && existing.plan.ai_plan) {
        const obj = JSON.parse(existing.plan.ai_plan);
        obj.checkedNodes = state.checkedNodes;
        // 同步里程碑的 done 状态
        if (obj.milestones) {
          obj.milestones = obj.milestones.map(m => ({
            ...m,
            done: !!state.checkedNodes[m.id]
          }));
        }
        planToSave = JSON.stringify(obj);
      }
    } catch(e) { console.warn('合并规划数据失败:', e); }
  }
  const res = await api('/api/plan', {
    method: 'POST',
    body: JSON.stringify({
      form_data: state.form,
      selected_tags: state.sel,
      mbti_result: state.mbti,
      ai_plan: planToSave || null,
      plan_title: '',
      api_model: ''
    })
  });
  if (res.ok) {
    console.log('✅ 规划数据已保存到服务器');
  } else {
    console.warn('⚠️ 规划数据保存失败:', res.msg);
  }
}

// ============================================================
//  ===== AI 状态检查 + 用户自定义 Key 配置 =====
// ============================================================

async function checkAIStatus() {
  const area = document.getElementById('aiStatusArea');
  const configArea = document.getElementById('userKeyConfigArea');
  if (!area) return;
  const res = await api('/api/ai/test', { method: 'POST' });
  if (res.ok) {
    const sourceLabel = res.key_source === 'user' ? '（使用你的 Key）' : '（服务端已配置）';
    area.innerHTML = `<div style="color:#16a34a;font-size:13px;">✅ AI 引擎就绪${res.model ? ' (' + res.model + ')' : ''}</div>
      <div style="color:#888;font-size:11px;margin-top:4px;">${sourceLabel} · 你的专属职业规划将由 AI 智能生成 🚀</div>`;
    // 服务端已配置时，隐藏用户配置区域
    if (res.key_source === 'server' && configArea) {
      configArea.style.display = 'none';
    }
  } else {
    const needKey = res.need_user_key;
    area.innerHTML = `<div style="color:#f59e0b;font-size:13px;">⚠️ ${res.msg || 'AI 服务暂不可用'}</div>
      <div style="color:#888;font-size:11px;margin-top:4px;">请配置你的 API Key 来解锁 AI 功能</div>`;
    // 需要用户配置 Key 时，显示配置区域
    if (needKey && configArea) {
      configArea.style.display = 'block';
      // 加载已有的用户设置
      loadUserAiSettings();
    }
  }
}

// 加载用户已有的 AI 设置
async function loadUserAiSettings() {
  try {
    const res = await api('/api/ai-settings', { method: 'GET' });
    if (res.ok && res.settings) {
      const s = res.settings;
      const keyInput = document.getElementById('userApiKeyInput');
      const urlInput = document.getElementById('userBaseUrlInput');
      const modelInput = document.getElementById('userModelInput');
      if (s.has_key && keyInput) keyInput.placeholder = '已配置: ' + (s.masked_key || '****') + '（留空则保持不变）';
      if (urlInput && s.ai_base_url) urlInput.value = s.ai_base_url;
      if (modelInput && s.ai_model) modelInput.value = s.ai_model;
    }
  } catch(e) {
    console.error('加载 AI 设置失败:', e);
  }
}

// 保存用户 AI Key
async function saveUserAiKey() {
  const key = document.getElementById('userApiKeyInput')?.value?.trim() || '';
  const baseUrl = document.getElementById('userBaseUrlInput')?.value?.trim() || '';
  const model = document.getElementById('userModelInput')?.value?.trim() || '';

  if (!key) {
    showToast('⚠️ 请输入 API Key');
    return;
  }

  const res = await api('/api/ai-settings', {
    method: 'POST',
    body: JSON.stringify({ ai_api_key: key, ai_base_url: baseUrl, ai_model: model })
  });

  if (res.ok) {
    showToast('✅ AI 配置已保存');
    // 清空 Key 输入框
    document.getElementById('userApiKeyInput').value = '';
    // 重新检测状态
    checkAIStatus();
  } else {
    showToast('❌ 保存失败: ' + (res.msg || '未知错误'));
  }
}

// 测试用户配置的 AI Key
async function testUserAiKey() {
  const key = document.getElementById('userApiKeyInput')?.value?.trim() || '';
  const baseUrl = document.getElementById('userBaseUrlInput')?.value?.trim() || '';
  const model = document.getElementById('userModelInput')?.value?.trim() || '';

  // 如果有新输入的 Key，先保存
  if (key) {
    await saveUserAiKey();
  } else {
    // 没有新 Key，直接测试已有配置
    checkAIStatus();
  }
}

